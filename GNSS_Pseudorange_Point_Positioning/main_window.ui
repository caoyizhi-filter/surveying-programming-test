<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1100</width><height>720</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>1000</width><height>0</height></size>
  </property>
  <property name="windowTitle">
   <string>GNSS伪距单点定位程序设计</string>
  </property>

  <!-- ===== QAction 菜单/工具栏动作 ===== -->
  <action name="actionOpen">
   <property name="text"><string>打开(&amp;O)</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
  </action>
  <action name="actionCalc">
   <property name="text"><string>计算(&amp;C)</string></property>
   <property name="shortcut"><string>Ctrl+C</string></property>
  </action>
  <action name="actionSave">
   <property name="text"><string>保存(&amp;S)</string></property>
   <property name="shortcut"><string>Ctrl+S</string></property>
  </action>
  <action name="actionClear">
   <property name="text"><string>清除(&amp;R)</string></property>
  </action>
  <action name="actionExit">
   <property name="text"><string>退出(&amp;X)</string></property>
   <property name="shortcut"><string>Alt+F4</string></property>
  </action>

  <!-- ===== 中心部件 ===== -->
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <item>
     <widget class="QSplitter" name="splitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>

      <!-- +++++ 左侧面板: 输入参数 +++++ -->
      <widget class="QGroupBox" name="groupInput">
       <property name="title"><string>输入参数</string></property>
       <property name="minimumSize">
        <size><width>280</width><height>0</height></size>
       </property>
       <layout class="QVBoxLayout" name="inputLayout">

        <!-- 文件信息 -->
        <item>
         <widget class="QLabel" name="labelFile">
          <property name="text"><string>未加载数据</string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <!-- 状态信息 -->
        <item>
         <widget class="QLabel" name="labelStatus">
          <property name="text"><string>请打开输入文件</string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <!-- 间隔线 -->
        <item>
         <widget class="Line" name="line">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
         </widget>
        </item>

        <!-- 卫星数据显示区域 -->
        <item>
         <widget class="QLabel" name="label_sat_title">
          <property name="text"><string>卫星数据:</string></property>
          <property name="font"><font><bold>true</bold></font></property>
         </widget>
        </item>
        <item>
         <widget class="QTextEdit" name="textSatData">
          <property name="readOnly"><bool>true</bool></property>
          <property name="font"><font><family>Consolas</family><pointsize>9</pointsize></font></property>
          <property name="placeholderText"><string>打开文件后显示卫星数据...</string></property>
         </widget>
        </item>

        <!-- 弹簧 -->
        <item>
         <spacer name="verticalSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>

       </layout>
      </widget>

      <!-- +++++ 右侧面板: 结果表格 +++++ -->
      <widget class="QWidget" name="rightPanel">
       <layout class="QVBoxLayout" name="rightLayout">
        <item>
         <widget class="QTableWidget" name="tableResult"/>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>

  <!-- ===== 菜单栏 ===== -->
  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>文件(&amp;F)</string></property>
    <addaction name="actionOpen"/>
    <addaction name="actionSave"/>
    <addaction name="separator"/>
    <addaction name="actionClear"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <widget class="QMenu" name="menuCalc">
    <property name="title"><string>计算(&amp;C)</string></property>
    <addaction name="actionCalc"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuCalc"/>
  </widget>

  <!-- ===== 工具栏 ===== -->
  <widget class="QToolBar" name="toolbar">
   <property name="windowTitle"><string>工具栏</string></property>
   <property name="movable"><bool>false</bool></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <addaction name="actionOpen"/>
   <addaction name="actionCalc"/>
   <addaction name="separator"/>
   <addaction name="actionSave"/>
   <addaction name="actionClear"/>
  </widget>

  <!-- ===== 状态栏 ===== -->
  <widget class="QStatusBar" name="statusbar"/>

 </widget>
</ui>
