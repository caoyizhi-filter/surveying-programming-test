<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>850</height></rect>
  </property>
  <property name="windowTitle">
   <string>遥感影像最大似然法分类系统</string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="hLayout">
    <item>
     <widget class="QSplitter" name="splitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>

      <!-- 左：数据表格区（Tab 切换） -->
      <widget class="QGroupBox" name="groupData">
       <property name="title"><string>数据与结果</string></property>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QTabWidget" name="tabWidget">
          <widget class="QWidget" name="tabStats">
           <attribute name="title"><string>训练样本统计</string></attribute>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTableWidget" name="tableStats">
              <property name="alternatingRowColors"><bool>true</bool></property>
              <property name="editTriggers">
               <set>QAbstractItemView::NoEditTriggers</set>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
          <widget class="QWidget" name="tabLikelihood">
           <attribute name="title"><string>似然值与分类结果</string></attribute>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTableWidget" name="tableLikelihood">
              <property name="alternatingRowColors"><bool>true</bool></property>
              <property name="editTriggers">
               <set>QAbstractItemView::NoEditTriggers</set>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
          <widget class="QWidget" name="tabCM">
           <attribute name="title"><string>混淆矩阵</string></attribute>
           <layout class="QVBoxLayout">
            <item>
             <widget class="QTableWidget" name="tableCM">
              <property name="alternatingRowColors"><bool>true</bool></property>
              <property name="editTriggers">
               <set>QAbstractItemView::NoEditTriggers</set>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- 右：绘图面板 -->
      <widget class="QGroupBox" name="groupPlot">
       <property name="title"><string>可视化分析</string></property>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QWidget" name="plotWidget" native="true">
          <property name="minimumSize"><size><width>400</width><height>350</height></size></property>
         </widget>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>

  <!-- 菜单栏 -->
  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect><x>0</x><y>0</y><width>1400</width><height>30</height></rect>
   </property>
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>文件(&amp;F)</string></property>
    <addaction name="actionOpenTrain"/>
    <addaction name="actionOpenPixels"/>
    <addaction name="actionExport"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <widget class="QMenu" name="menuOp">
    <property name="title"><string>操作(&amp;O)</string></property>
    <addaction name="actionRun"/>
    <addaction name="actionVerify"/>
    <addaction name="separator"/>
    <addaction name="actionClear"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuOp"/>
  </widget>

  <!-- 工具栏 -->
  <widget class="QToolBar" name="toolBar">
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <addaction name="actionOpenTrain"/>
   <addaction name="actionOpenPixels"/>
   <addaction name="actionRun"/>
   <addaction name="actionVerify"/>
   <addaction name="actionExport"/>
   <addaction name="separator"/>
   <addaction name="actionClear"/>
  </widget>

  <widget class="QStatusBar" name="statusbar"/>

  <action name="actionOpenTrain">
   <property name="text"><string>读取训练样本(&amp;T)</string></property>
   <property name="shortcut"><string>Ctrl+T</string></property>
  </action>
  <action name="actionOpenPixels">
   <property name="text"><string>读取待分类像元(&amp;P)</string></property>
   <property name="shortcut"><string>Ctrl+P</string></property>
  </action>
  <action name="actionRun">
   <property name="text"><string>最大似然分类解算(&amp;R)</string></property>
   <property name="shortcut"><string>F5</string></property>
  </action>
  <action name="actionVerify">
   <property name="text"><string>精度验证(&amp;V)</string></property>
   <property name="shortcut"><string>F6</string></property>
  </action>
  <action name="actionExport">
   <property name="text"><string>导出结果(&amp;S)</string></property>
   <property name="shortcut"><string>Ctrl+S</string></property>
  </action>
  <action name="actionClear">
   <property name="text"><string>清空数据</string></property>
  </action>
  <action name="actionExit">
   <property name="text"><string>程序退出(&amp;Q)</string></property>
   <property name="shortcut"><string>Ctrl+Q</string></property>
  </action>

 </widget>
