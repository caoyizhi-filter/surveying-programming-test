<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
  main_window.ui  —  Qt Designer 界面模板

  【使用流程】
    1. Qt Designer 打开此文件
    2. 修改控件（增删 QLabel、改标题、改菜单文字）
    3. 保存
    4. 命令行: pyuic5 -o main_window_ui.py main_window.ui
    5. 生成的 .py 文件不要手动改

  【当前示例界面: 道路曲线要素计算】
    左侧面板包含:
      - 3个 QLabel: 文件名、JD信息、状态
      - 4个 QLineEdit: JD里程、半径、偏角(度/分/秒)、指定桩号
    右侧: QTableWidget 结果表格（3列）

  【做新题目时改什么】
    - 窗口标题 (windowTitle)
    - 左侧面板的 QLabel 和 QLineEdit（根据题目增删）
    - 菜单文字（如"打开"→"读取正算文件"）
    - 控件 objectName（取有意义的英文名）
===================================================================== -->
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1100</width><height>720</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>1000</width><height>0</height></size>
  </property>
  <property name="windowTitle">
   <string>道路曲线要素计算与里程桩计算程序设计</string>
   <!-- <FILL: 改成你的窗口标题> -->
  </property>

  <!-- ==========================================================
       QAction — 菜单栏和工具栏共用的动作
       每个 action 有: objectName(英文) + text(显示文字) + shortcut(快捷键)
       ========================================================== -->
  <action name="actionOpen">
   <property name="text"><string>打开(&amp;O)</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
  </action>
  <action name="actionCalc">
   <property name="text"><string>计算(&amp;C)</string></property>
   <property name="shortcut"><string>Ctrl+C</string></property>
  </action>
  <action name="actionSave">
   <property name="text"><string>保存(&amp;S)</string></property>
   <property name="shortcut"><string>Ctrl+S</string></property>
  </action>
  <action name="actionClear">
   <property name="text"><string>清除(&amp;R)</string></property>
  </action>
  <action name="actionExit">
   <property name="text"><string>退出(&amp;X)</string></property>
   <property name="shortcut"><string>Alt+F4</string></property>
  </action>

  <!-- ==========================================================
       中心部件: QSplitter 左右分栏
       ========================================================== -->
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <item>
     <widget class="QSplitter" name="splitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>

      <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++
           左侧面板: QGroupBox "输入参数"
           包含 QLabel + QLineEdit 的 FormLayout
           ++++++++++++++++++++++++++++++++++++++++++++++++++ -->
      <widget class="QGroupBox" name="groupInput">
       <property name="title"><string>输入参数</string></property>
       <property name="minimumSize">
        <size><width>250</width><height>0</height></size>
       </property>
       <layout class="QVBoxLayout" name="inputLayout">

        <!-- 文件信息标签 -->
        <item>
         <widget class="QLabel" name="labelFile">
          <property name="text"><string>未加载数据</string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <!-- 状态标签 -->
        <item>
         <widget class="QLabel" name="labelStatus">
          <property name="text"><string>请打开输入文件</string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>

        <!-- 间隔线 -->
        <item>
         <widget class="Line" name="line">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
         </widget>
        </item>

        <!-- 输入表单 (QFormLayout) -->
        <!-- JD 里程 -->
        <item>
         <layout class="QFormLayout" name="formLayout">
          <item row="0">
           <widget class="QLabel" name="label_jd">
            <property name="text"><string>JD 里程 (K+xxx):</string></property>
           </widget>
          </item>
          <item row="0">
           <widget class="QLineEdit" name="edit_jd">
            <property name="placeholderText"><string>如 1326.480</string></property>
           </widget>
          </item>
          <!-- 半径 R -->
          <item row="1">
           <widget class="QLabel" name="label_r">
            <property name="text"><string>圆曲线半径 R (m):</string></property>
           </widget>
          </item>
          <item row="1">
           <widget class="QLineEdit" name="edit_r">
            <property name="placeholderText"><string>如 280</string></property>
           </widget>
          </item>
          <!-- 偏角度 -->
          <item row="2">
           <widget class="QLabel" name="label_alpha">
            <property name="text"><string>偏角 α (°):</string></property>
           </widget>
          </item>
          <item row="2">
           <layout class="QHBoxLayout" name="alphaLayout">
            <item>
             <widget class="QLineEdit" name="edit_deg">
              <property name="placeholderText"><string>度</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_deg_sign">
              <property name="text"><string>°</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="edit_min">
              <property name="placeholderText"><string>分</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_min_sign">
              <property name="text"><string>'</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="edit_sec">
              <property name="placeholderText"><string>秒</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="label_sec_sign">
              <property name="text"><string>"</string></property>
             </widget>
            </item>
           </layout>
          </item>
          <!-- 指定桩号 -->
          <item row="3">
           <widget class="QLabel" name="label_stake">
            <property name="text"><string>指定桩号 (K+xxx):</string></property>
           </widget>
          </item>
          <item row="3">
           <widget class="QLineEdit" name="edit_stake">
            <property name="placeholderText"><string>如 1400.000</string></property>
           </widget>
          </item>
         </layout>
        </item>

        <!-- 弹簧: 把控件推到顶部 -->
        <item>
         <spacer name="verticalSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>

       </layout>
      </widget>

      <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++
           右侧面板: QTableWidget 结果表格（3列）
           ++++++++++++++++++++++++++++++++++++++++++++++++++ -->
      <widget class="QWidget" name="rightPanel">
       <layout class="QVBoxLayout" name="rightLayout">
        <item>
         <widget class="QTableWidget" name="tableResult"/>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>

  <!-- ==========================================================
       菜单栏
       ========================================================== -->
  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>文件(&amp;F)</string></property>
    <addaction name="actionOpen"/>
    <addaction name="actionSave"/>
    <addaction name="separator"/>
    <addaction name="actionClear"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <widget class="QMenu" name="menuCalc">
    <property name="title"><string>计算(&amp;C)</string></property>
    <addaction name="actionCalc"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuCalc"/>
  </widget>

  <!-- ==========================================================
       工具栏
       ========================================================== -->
  <widget class="QToolBar" name="toolbar">
   <property name="windowTitle"><string>工具栏</string></property>
   <property name="movable"><bool>false</bool></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <addaction name="actionOpen"/>
   <addaction name="actionCalc"/>
   <addaction name="separator"/>
   <addaction name="actionSave"/>
   <addaction name="actionClear"/>
  </widget>

  <!-- ==========================================================
       状态栏
       ========================================================== -->
  <widget class="QStatusBar" name="statusbar"/>

 </widget>
</ui>
